+def sha(path):
+    h = hashlib.sha256()
+    with Path(path).open('rb') as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def command(args):
+    return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()
